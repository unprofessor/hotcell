-- allium: 3
-- hotcell.allium

-- Scope: Hotcell — an AI coding agent sandbox
-- Includes: Cell (isolated environment), Cellfile (declaration source),
--           Session (program invocation), provisioning, network firewall,
--           filesystem isolation, logging
-- Excludes:
--   - Authentication and authorization of callers
--   - Billing, quota, resource limits
--   - Choice of agent program (hotcell runs any executable)
--   - Cellfile format and parsing (implementation detail)
-- Dependencies: none

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity Developer {
    -- The human operator who authors Cellfiles and invokes programs inside cells.
}

external entity AgentProgram {
    -- The executable hotcell runs inside a cell. Hotcell does not manage or
    -- constrain which program this is; it simply executes it in the sandbox.
}

external entity Cellfile {
    -- A declaration file at {directory}/Cellfile. Content is developer-authored
    -- and read fresh on every access, so the declaration always reflects the
    -- current file. Contains a single CellDeclaration; it does not define names.
    directory: String
    declaration: CellDeclaration
}

external entity RepoBindings {
    -- The operator's machine-local repo bindings for a Cellfile directory.
    -- Operator-authored rather than author-authored, uncommitted, and read
    -- fresh on every access just as the Cellfile is. Kept separate from the
    -- Cellfile because a binding is true of one machine, while a Cellfile is
    -- meant to travel.
    directory: String
    bindings: Set<RepoBinding>
}

external entity ProvisioningProcess {
    -- hotcell's internal provisioning system: installs packages, seeds files,
    -- configures the network firewall and environment. The provisioner is
    -- pluggable: the Cellfile declares which provisioner kind to use, and the
    -- spec does not prescribe how a given kind provisions — only that it
    -- reports success or failure as outcomes. Known kinds: "none" (a no-op
    -- provisioner that leaves the cell empty) and "script" (execute a shell
    -- script that seeds the cell's filesystem). Further kinds may be added
    -- without changing this contract.
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value Endpoint {
    host: String
    port: Integer?
}

value NetworkPolicy {
    -- Offline by default: an empty allowed_endpoints set means no network access.
    allowed_endpoints: Set<Endpoint>
}

value FileMapping {
    source: String       -- host path to seed from
    target: String       -- path inside the sandbox filesystem
}

value EnvVar {
    -- An environment variable presented to the agent. `key` names it; `source`
    -- says where its value comes from (see EnvSource). `value` carries the
    -- literal text and is present ONLY when source = literal. For a passthrough
    -- or secret variable the value is resolved from hotcell's own environment
    -- at launch (see the RunCell surfaces) and is deliberately absent here, so
    -- a resolved passthrough or secret value never becomes part of the
    -- declaration — and therefore never reaches provisioned_as or is_current.
    key: String
    source: EnvSource
    value: String?       -- set only when source = literal; null otherwise
}

value Provisioner {
    -- Declares which provisioner brings the cell's environment into being.
    -- kind is an open set; the spec does not prescribe what a provisioner of
    -- a given kind does, only that one is selected from the declaration and
    -- that it reports success or failure. "none" is a no-op; "script" runs
    -- the script at `script` (relative to the Cellfile directory).
    --
    -- host_paths are host filesystem paths the provisioner may read
    -- (read-only) while provisioning — e.g. a language runtime tree to copy
    -- into the cell. They are the provisioner's bootstrap allowance and are
    -- never visible to the agent. See the ProvisioningRuntime surface's
    -- BootstrapRiskProfile guarantee.
    kind: String
    script: String?
    host_paths: Set<String>
}

value RepoSlot {
    -- A logical repository the cell works on, declared in the Cellfile. The
    -- Cellfile names the slot; it deliberately does not say where that
    -- repository lives on any particular machine, so a Cellfile stays
    -- portable across operators. An operator supplies the location as a
    -- RepoBinding.
    --
    -- The name carries no meaning to hotcell — it is an out-of-band agreement
    -- between the Cellfile's author and its operator. Its form is
    -- constrained: see the SlotNamesAreUsable guarantee.
    name: String
    mount: String?       -- path inside the cell; defaults to {workdir}/{name}
}

value RepoBinding {
    -- An operator's machine-local resolution of a slot name to a repository
    -- on this host. Bindings are never part of the Cellfile and never part of
    -- a cell's provisioning identity.
    name: String
    path: String         -- host path of the repository to exchange with
}

value CellDeclaration {
    packages: Set<String>
    files: Set<FileMapping>
    environment: Set<EnvVar>
    repos: Set<RepoSlot>
    network: NetworkPolicy
    workdir: String
    provisioner: Provisioner

    -- The subset of the declaration that determines the provisioned
    -- filesystem, and therefore the cell's identity for the purpose of
    -- deciding whether to re-provision.
    --
    -- `environment` and `repos` are deliberately excluded. Environment
    -- variables are resolved and handed to the agent at launch; they do not
    -- shape the rootfs, so editing one should not reproduce an identical
    -- filesystem from scratch. Repo slots describe an exchange arrangement
    -- outside the rootfs entirely, so adding, removing or renaming one must
    -- not force a re-provision either. Excluding them here is what makes that
    -- structural rather than a rule each caller has to remember.
    provisioning_identity: {
        packages: packages,
        files: files,
        network: network,
        workdir: workdir,
        provisioner: provisioner
    }
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum EnvSource {
    -- Where an environment variable's value comes from.
    --   literal      the value is written in the Cellfile and travels with the
    --                declaration.
    --   passthrough  the value is NOT written in the Cellfile; the Cellfile
    --                names the variable, and hotcell reads its value from its
    --                own environment at launch. The resolved value never enters
    --                the declaration.
    --   secret       like passthrough (resolved from hotcell's environment at
    --                launch, never written in the Cellfile), and additionally
    --                masked as <redacted> wherever hotcell displays the run.
    literal | passthrough | secret
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Cell {
    -- Identity is the pair (Cellfile, name). The Cellfile does not define
    -- names; the name is a developer-chosen label, defaulting to "default",
    -- so multiple cells can be created from a single Cellfile.
    cellfile: Cellfile
    repo_bindings: RepoBindings
    name: String
    status: unprovisioned | provisioning | provisioned | provisioning_failed

    sessions: Session with cell = this
    active_sessions: sessions where status = running

    -- Host-side repositories mediating exchange for this cell, one per bound
    -- slot. A shadow exists or it does not; its lifecycle is Birth and Death
    -- rather than a status field.
    shadows: Shadow with cell = this
    orphaned_shadows: shadows where is_orphaned

    -- Every declared slot has a binding on this machine. A declared slot is
    -- a requirement, not an offer: a cell missing one cannot run.
    all_slots_bound: cellfile.declaration.repos.all(
        r => repo_bindings.bindings.any(b => b.name = r.name)
    )

    -- Every binding names a slot the Cellfile declares. The Cellfile is not
    -- the authority on where repositories live, but it is the authority on
    -- which repositories a cell has, so a binding without a slot is an error
    -- rather than an extra repository.
    no_naked_bindings: repo_bindings.bindings.all(
        b => cellfile.declaration.repos.any(r => r.name = b.name)
    )

    -- True when no shadow holds work that has not reached the operator's
    -- repository. Guards destruction; see WorkNotSilentlyLost.
    shadows_fully_fetched: shadows.all(s => not s.has_unfetched_work)

    -- The declaration the cell was last provisioned with. Set when
    -- provisioning succeeds. Because a passthrough or secret EnvVar carries no
    -- value (see EnvVar), a resolved passthrough or secret value is never
    -- recorded here — only the variable's key and source are. A secret's
    -- resolved value existing in no stored field is a guarantee, not an
    -- implementation detail.
    provisioned_as: CellDeclaration when status = provisioned

    -- A fingerprint of the provisioner's script content, recorded at
    -- provisioning time. Used to detect that the script a cell was
    -- provisioned with is unchanged, so a re-run can skip re-provisioning
    -- (see provisioner_inputs_unchanged). null for provisioners with no
    -- script (kind = "none").
    provisioned_script_digest: String? when status = provisioned

    -- The program and arguments to run once provisioning completes. Carried
    -- through the provisioning phase so the session can start on success.
    pending_program: String when status = provisioning
    pending_args: List<String> when status = provisioning

    -- Description of what went wrong when provisioning fails.
    provisioning_error: String when status = provisioning_failed

    -- True (fresh) when the provisioned filesystem still matches what the
    -- Cellfile asks for. False (stale) when a provisioning-relevant part of
    -- the Cellfile has changed since the last provisioning.
    --
    -- Comparison is over provisioning_identity, not the whole declaration, so
    -- changes that cannot affect the rootfs do not force a rebuild: editing an
    -- environment variable, or adding, removing or renaming a repo slot,
    -- leaves a provisioned cell fresh. Changes to packages, seeded files,
    -- network policy, workdir or the provisioner do make it stale.
    --
    -- Independently of that, a declaration records only an EnvVar's key and
    -- source and never a resolved passthrough or secret value, so rotating a
    -- host secret between runs cannot make a cell stale either.
    is_current: provisioned_as.provisioning_identity = cellfile.declaration.provisioning_identity

    -- True when the provisioner's inputs are the same as when the cell was
    -- last provisioned. provisioner_digest(provisioner, directory) is a
    -- black box function returning a fingerprint of the provisioner's script
    -- content at {directory}/{script}, or null when the provisioner has no
    -- script (kind = "none"); it is pure and deterministic for the same
    -- inputs within a rule execution. For a no-script provisioner both sides
    -- are null, so this is true. Combined with is_current, this is the
    -- condition under which re-provisioning would only reproduce the same
    -- rootfs and may be skipped.
    provisioner_inputs_unchanged: provisioned_script_digest = provisioner_digest(cellfile.declaration.provisioner, cellfile.directory)

    transitions status {
        unprovisioned -> provisioning
        provisioning -> provisioned
        provisioning -> provisioning_failed
        provisioning_failed -> provisioning
        provisioning_failed -> unprovisioned
        provisioned -> provisioning
        provisioned -> unprovisioned
    }
}

entity Shadow {
    -- A host-side repository that mediates exchange between the operator's
    -- repository and the cell, for one declared slot. Both sides treat it as
    -- an ordinary remote: the agent sees it as its origin, the operator sees
    -- it as an additional remote alongside their own. Neither side reaches
    -- into the other's filesystem, which is why exchange does not weaken
    -- FilesystemIsolation.
    --
    -- A shadow exists or it does not. Its lifecycle is Birth and Death rather
    -- than a status field, and Death is the exact inverse of Birth.
    cell: Cell
    slot_name: String

    -- The host repository this shadow was born from. Kept for provenance: it
    -- lets an orphan explain which repository it came from rather than only
    -- naming a slot that no longer exists.
    origin_path: String

    -- True when the shadow holds work that has not reached the repository it
    -- was born from. This is the condition that makes destroying a shadow
    -- lossy, and the only thing standing between an agent's work and its
    -- silent disappearance.
    has_unfetched_work: holds_unfetched_work(this)

    -- True when the Cellfile no longer declares this shadow's slot. Renaming
    -- a slot produces an orphan and a new shadow, which is the correct
    -- reading: a renamed slot is a different repository as far as the cell is
    -- concerned.
    is_orphaned: not cell.cellfile.declaration.repos.any(r => r.name = slot_name)
}

entity Session {
    cell: Cell
    program: String
    args: List<String>
    status: running | completed
    started_at: Timestamp
    ended_at: Timestamp when status = completed
    exit_code: Integer when status = completed

    -- Path to hotcell's log file for this session. While the agent runs,
    -- hotcell redirects its own logging here to avoid disturbing the agent's
    -- terminal interface. The path is derived from the cell's state directory.
    log_file: String when status = running

    transitions status {
        running -> completed
        terminal: completed
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    workdir: String = "/work"
    default_cell_name: String = "default"
    state_dir: String = ".cell"
    default_provisioner_kind: String = "none"

    -- Name of the remote a shadow installs in the operator's repository. The
    -- cell's own view of the same repository is always "origin", so the two
    -- sides name it differently on purpose: the agent sees an unremarkable
    -- origin and needs no knowledge of hotcell.
    shadow_remote_name: String = "shadow"
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Run initiation: every hotcell run enters the provisioning phase first.
-- The cell transitions to "provisioning" and the provisioning process
-- attempts to bring the environment in line with the Cellfile.

rule CreateCellForProvisioning {
    when: RunCell(cellfile, name, program, args)
    requires: not exists Cell{cellfile, name}
    ensures:
        Cell.created(
            cellfile: cellfile,
            name: name,
            status: provisioning,
            pending_program: program,
            pending_args: args
        )
}

rule ReprovisionFromUnprovisioned {
    when: RunCell(cellfile, name, program, args)
    requires: exists Cell{cellfile, name}
    let cell = Cell{cellfile, name}
    requires: cell.status = unprovisioned
    ensures:
        cell.status = provisioning
        cell.pending_program = program
        cell.pending_args = args
}

rule ReprovisionFromFailed {
    when: RunCell(cellfile, name, program, args)
    requires: exists Cell{cellfile, name}
    let cell = Cell{cellfile, name}
    requires: cell.status = provisioning_failed
    ensures:
        cell.status = provisioning
        cell.provisioning_error = null
        cell.pending_program = program
        cell.pending_args = args
}

rule SkipProvisioningWhenUnchanged {
    when: RunCell(cellfile, name, program, args)
    requires: exists Cell{cellfile, name}
    let cell = Cell{cellfile, name}
    requires: cell.status = provisioned
    requires: cell.is_current
    requires: cell.provisioner_inputs_unchanged
    ensures:
        Session.created(
            cell: cell,
            program: program,
            args: args,
            status: running,
            started_at: now,
            log_file: log_file_path(cell)
        )
}

rule ReconcileFromProvisioned {
    when: RunCell(cellfile, name, program, args)
    requires: exists Cell{cellfile, name}
    let cell = Cell{cellfile, name}
    requires: cell.status = provisioned
    requires: not (cell.is_current and cell.provisioner_inputs_unchanged)
    ensures:
        cell.status = provisioning
        cell.provisioned_as = null
        cell.provisioned_script_digest = null
        cell.pending_program = program
        cell.pending_args = args
}

-- Provisioning outcomes: the provisioning process reports success or failure.
-- On success, the cell is provisioned and a session starts. On failure, the
-- cell enters provisioning_failed and no session starts.

rule ProvisionSucceeds {
    when: ProvisioningSucceeded(cell, declaration)
    requires: cell.status = provisioning
    let program = cell.pending_program
    let args = cell.pending_args
    ensures:
        cell.status = provisioned
        cell.provisioned_as = declaration
        cell.provisioned_script_digest = provisioner_digest(declaration.provisioner, cell.cellfile.directory)
        cell.pending_program = null
        cell.pending_args = null
        Session.created(
            cell: cell,
            program: program,
            args: args,
            status: running,
            started_at: now,
            log_file: log_file_path(cell)
        )
}

rule ProvisionFails {
    when: ProvisioningFailed(cell, error)
    requires: cell.status = provisioning
    let program = cell.pending_program
    let args = cell.pending_args
    ensures:
        cell.status = provisioning_failed
        cell.provisioning_error = error
        cell.pending_program = null
        cell.pending_args = null
}

-- Session completes when the program exits.

rule SessionCompletes {
    when: ProgramExits(session, exit_code)
    requires: session.status = running
    ensures:
        session.status = completed
        session.ended_at = now
        session.exit_code = exit_code
        session.log_file = null
}

-- Workspace exchange: shadows are reconciled against the current declaration
-- rather than tracked through change events. Comparing present state to
-- present declaration means there is no history to be fooled by a change that
-- reverts itself, and reconciliation converges from any starting state —
-- including one an operator has edited by hand.

rule BirthShadowForDeclaredSlot {
    when: ReconcileShadows(cell)
    requires: cell.all_slots_bound
    requires: cell.no_naked_bindings
    for slot in cell.cellfile.declaration.repos:
        requires: not exists Shadow{cell: cell, slot_name: slot.name}
        ensures:
            Shadow.created(
                cell: cell,
                slot_name: slot.name,
                origin_path: bound_path(cell.repo_bindings, slot.name)
            )
}

rule DeathOfOrphanedShadow {
    when: ReconcileShadows(cell)
    requires: cell.all_slots_bound
    requires: cell.no_naked_bindings
    for shadow in cell.orphaned_shadows:
        requires: not shadow.has_unfetched_work
        ensures: not exists shadow

    @guidance
        -- An orphan holding unfetched work does not reconcile. The operator
        -- is told what it is and where it came from, and chooses: fetch it,
        -- restore the slot, or discard it deliberately. Reconciliation never
        -- resolves that on their behalf.
}

-- Destroying: tear down the provisioned filesystem, return to unprovisioned.
-- Destruction also takes the cell's shadows, so it carries the same
-- work-preservation guard, and the same deliberate override.

rule DestroyCell {
    when: DestroyCellCommand(cell, force)
    requires: cell.status in {provisioned, provisioning_failed}
    requires: cell.active_sessions.count = 0
    requires: cell.shadows_fully_fetched or force
    ensures:
        cell.status = unprovisioned
        cell.provisioned_as = null
        cell.provisioned_script_digest = null
        cell.provisioning_error = null
        for shadow in cell.shadows:
            not exists shadow
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The agent's view from inside the cell: an isolated filesystem, network
-- access per the provisioned policy, and the declared environment.

surface Cleanroom {
    facing agent: AgentProgram

    context cell: Cell where status = provisioned

    exposes:
        cell.provisioned_as.workdir
        cell.provisioned_as.environment
        cell.provisioned_as.network.allowed_endpoints

    @guarantee FilesystemIsolation
        -- The agent cannot access any host filesystem path outside the
        -- sandbox. All file operations are confined to the cell's filesystem.

    @guarantee ProvisionedEnvironment
        -- The agent's tools, files, and working directory are provisioned into
        -- the cell's filesystem by the declared provisioner before the session
        -- starts. The sandbox does not bind-mount host-specific tool directories
        -- (language runtimes, agent binaries, skills, agent config); only
        -- read-only base system directories and the cell's own filesystem are
        -- visible. A provisioned cell is reproducible from its Cellfile — no
        -- host state leaks in beyond the shared read-only base system.

    @guarantee NetworkFirewall
        -- The agent can only reach endpoints in the cell's provisioned
        -- network policy. All other network connections are blocked.
        -- Enforcement is via an HTTP proxy; non-HTTP traffic is blocked by
        -- default. A cell with no allowed endpoints has no network access.

    @guarantee WorkspaceExchangeIsMediated
        -- A bound repository reaches the agent as an ordinary git remote it
        -- can fetch from and push to, not as a host path it can read. No part
        -- of the operator's filesystem becomes visible or writable inside the
        -- cell, so exchange adds a channel without weakening
        -- FilesystemIsolation. The agent needs no knowledge that the remote is
        -- anything unusual.

    @guarantee CleanEnvironment
        -- Only declared packages, seeded files and declared environment
        -- variables are present when a session starts. No host state leaks in
        -- except through the environment variables the Cellfile explicitly
        -- declares: a passthrough (source = passthrough) or secret
        -- (source = secret) variable is a deliberate, opt-in channel for one
        -- named value from hotcell's own environment. Nothing undeclared
        -- crosses into the sandbox.

    @guarantee EnvironmentResolvedAtLaunch
        -- The agent's environment is the declared EnvVars resolved to concrete
        -- values at launch: a literal contributes its own value, while a
        -- passthrough or secret contributes the value read from hotcell's
        -- environment at that moment. These resolved values are handed to the
        -- agent only; they are never written back into the declaration, so they
        -- cannot reach provisioned_as or influence is_current.
}

-- The developer's view, scoped to the Cellfile in their current working
-- directory. Status discovery is per-directory, not global.

surface DeveloperCLI {
    facing developer: Developer

    context cwd: Cellfile

    exposes:
        for cell in Cells where cellfile = cwd:
            cell.name
            cell.status
            cell.is_current

    provides:
        ReconcileShadows(cell)
            when cell.cellfile = cwd
        RunCell(cwd, name, program, args, provisioner_override?)
            -- name defaults to config.default_cell_name when omitted.
            -- provisioner_override, when given, replaces the Cellfile's
            -- declared provisioner (kind and, for "script", the script path)
            -- for this run only; the Cellfile's declared provisioner.host_paths
            -- are preserved. The override is a one-shot deviation, so the
            -- recorded provisioned_as reflects it and a subsequent run without
            -- the override re-provisions.
        DestroyCellCommand(cell, force)
            when cell.cellfile = cwd
            -- force overrides the refusal to destroy unfetched work. It does
            -- not override any other precondition, and it is distinct from
            -- skipping the confirmation prompt: one declines to ask, the
            -- other accepts a loss.

    @guarantee RelayOnly
        -- hotcell run blocks until the program exits, relaying stdin/stdout/stderr
        -- to the developer's terminal and faithfully passing the exit code. There is
        -- no attach/detach: a session's stdio is tied to the invocation that started
        -- it. Detaching and reattaching later is out of scope (use a terminal
        -- multiplexer if you need that).

    @guarantee ProvisioningLogsToConsole
        -- During provisioning, hotcell logs progress and errors to the console.
        -- If provisioning fails, the error is shown on the console and no session
        -- starts.

    @guarantee DeclaredVariableMustResolve
        -- A passthrough or secret variable that is declared but absent from
        -- hotcell's own environment at launch is a hard error: hotcell reports
        -- which variable is missing and aborts the run before any session
        -- starts, rather than handing the agent a cell short a variable it was
        -- promised. A literal always resolves (its value is in the Cellfile).

    @guarantee SecretsRedactedInRunOutput
        -- Wherever hotcell displays a run to the developer (the execution plan,
        -- including a dry run), a variable declared with source = secret is
        -- shown with its value masked as <redacted>. A passthrough is not
        -- masked, so the developer can still see what the agent receives.
        -- Redaction is keyed off the declared secret source, not a guess from
        -- the variable's name.

    @guarantee SessionLogsToFile
        -- Once the agent starts, hotcell redirects its own logging to a file and
        -- prints the log file's location to the console. This keeps the agent's
        -- terminal interface (TUI) undisturbed while hotcell runs.

    @guarantee PostSessionReport
        -- After the agent exits, hotcell reports to the console whether errors
        -- occurred and the session's final status.

    @guarantee FilesPersistAfterSession
        -- Files the agent produces during a session remain in the cell's
        -- filesystem after the session ends. They are accessible to the
        -- developer until the cell is destroyed. The cell's filesystem is
        -- backed by the state directory, so agent-produced files live
        -- alongside other cell state.

    @guarantee BindableCellOrEarlyFailure
        -- A declared repo slot is a requirement. If any slot has no binding on
        -- this machine, or any binding names a slot the Cellfile does not
        -- declare, hotcell reports which one and aborts before any session
        -- starts — the same treatment a declared-but-unset passthrough or
        -- secret variable receives. The developer is never handed a cell
        -- quietly missing a repository it was promised, nor one silently
        -- carrying a repository its Cellfile never mentioned.

    @guarantee SlotNamesAreUsable
        -- hotcell attaches no meaning to a slot name; it is an agreement
        -- between a Cellfile's author and its operator. It does constrain the
        -- form, because a name determines where the repository appears inside
        -- the cell and how it is addressed. A name that would be unsafe or
        -- ambiguous in those positions is rejected when the Cellfile is read,
        -- not when it is first used.

    @guarantee WorkNotSilentlyLost
        -- Destroying a cell destroys its shadows, and reconciliation destroys
        -- a shadow whose slot is gone. Neither happens while that shadow holds
        -- work the operator's repository has not received: hotcell refuses,
        -- names the shadow and the repository it was born from, and leaves the
        -- decision to the developer. The refusal can be overridden
        -- deliberately, which is a separate act from confirming the command.
        --
        -- What hotcell cannot see, it does not claim to protect: work the
        -- agent never committed, or committed but never sent to the shadow,
        -- is beyond the boundary and is lost with the cell.

    @guarantee ExchangeIsPeerToPeer
        -- Neither side owns the other. The operator's repository and the
        -- cell's are peers exchanging through a shared repository, so
        -- receiving the agent's work never rewrites the developer's branches
        -- — it arrives as a remote's refs, to be merged or discarded like any
        -- other remote's. Nothing hotcell does to the operator's repository
        -- goes beyond adding and removing that one remote.

    @guarantee StateColocatedWithCellfile
        -- Cell state persists in the state directory ({directory}/{state_dir})
        -- alongside the Cellfile, so it follows the Cellfile across directory
        -- renames. A cell's identity is (Cellfile, name), not its directory
        -- path; renaming the directory does not orphan the cell.

    @guidance
        -- Convention over configuration: hotcell looks for $PWD/Cellfile.
        -- The default cell name is "default"; additional names let a developer
        -- create more than one cell from a single Cellfile.
}

-- The provisioning process reports outcomes. This is not a developer action;
-- it is an internal process that succeeds or fails.

surface ProvisioningRuntime {
    facing provisioner: ProvisioningProcess

    context cell: Cell where status = provisioning

    provides:
        ProvisioningSucceeded(cell, declaration)
        ProvisioningFailed(cell, error)

    @guarantee ProvisionerRunsInCell
        -- The provisioner executes inside the cell's isolated filesystem,
        -- writing into the same rootfs the agent will later see. It does not
        -- run directly on the host; it is sandboxed just as the agent is, but
        -- under a different permissions profile.

    @guarantee HostPathsStaged
        -- Host paths the provisioner may read (the Cellfile directory and
        -- provisioner.host_paths) are bind-mounted under a neutral staging
        -- prefix inside the provisioning sandbox, not at their original host
        -- paths. This prevents the sandbox runtime from leaving a skeleton of
        -- the host's directory structure (e.g. /home/<user>/...) in the cell
        -- rootfs, which would leak the host username and layout to the agent.
        -- The staging prefix is removed from the rootfs after provisioning.

    @guarantee BootstrapRiskProfile
        -- The provisioner runs a trusted, developer-authored process and so
        -- carries a broader risk profile than the agent: read-only access to
        -- the host paths declared in `provisioner.host_paths` (to install
        -- tools from) and network egress (to fetch packages). The agent, by
        -- contrast, runs under the Cleanroom profile with no host-path access
        -- and firewall-enforced network. This asymmetry is the core of the
        -- permissions model: the provisioner may bootstrap, the agent may not.

    @guarantee ProvisionerCannotWriteHost
        -- Despite its broader read access, the provisioner cannot modify any
        -- host path. All host binds are read-only; writes are confined to the
        -- cell's rootfs.

    @guarantee ProvisionerCleanEnvironment
        -- The provisioner's environment is the host environment plus hotcell
        -- control variables (HOTCELL_*), with one deliberate override: HOME is
        -- set to a cell-local path (the agent's declared env.HOME, defaulting
        -- to /home/agent) so tools that cache into $HOME do not create a ghost
        -- of the host user's home inside the cell rootfs. The original host
        -- HOME is exposed via HOTCELL_HOST_HOME so a script can still locate
        -- host config through its provision.host_path binds. This keeps the
        -- provisioner's bootstrap tooling intact while the agent gets a clean,
        -- declared-only environment.
}

-- The sandbox runtime reports program exit. This is not a developer action;
-- it is an observable outcome from inside the cell.

surface SandboxRuntime {
    facing runtime: AgentProgram

    context session: Session where status = running

    provides:
        ProgramExits(session, exit_code)
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

deferred SessionTermination.terminate    -- see: detailed/session-termination.allium
-- Roadmap: allow a developer to forcibly stop a running session so that a
-- cell can be destroyed without waiting for the program to exit on its own.

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "When a session is terminated, does it reach the same 'completed' state as a natural exit, or a distinct 'terminated' state with its own exit semantics?"
open question "Network policy granularity: hostname/domain allowlist is sufficient for v1, but further research is needed on whether port-level restrictions, protocol restrictions, or path-level restrictions are required for real-world agent workflows"
open question "provisioning_identity excludes the whole environment, which is only sound once nothing in provisioning reads that environment. ProvisionerCleanEnvironment still sets the provisioner's HOME from the agent's declared env.HOME, so until that coupling is cut, a change to HOME can alter the rootfs a provisioner produces while leaving the cell fresh. The chosen resolution is to give provisioning its own declared home rather than special-case HOME in identity; this specification describes the state after that change. Are there other provisioning inputs drawn from the agent's declared environment that the same argument would cover?"
open question "Does boundary inspection of exchanged content (scanning or sanitising what crosses in either direction) belong in this contract, or does it remain outside the specification until a concrete policy exists? v1 assumes the latter and deliberately says nothing about it."
open question "Can a provisioner mutate the declaration during provisioning (e.g. inject environment variables it discovered), or is the declaration strictly authoritative and the provisioner only seeds the filesystem? v1 assumes the latter."
